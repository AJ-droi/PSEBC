# Neon connection string (use the *pooled* URL for the API). Must include sslmode=require on Neon.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-west-2.aws.neon.tech/psebc?sslmode=require
# Long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string
# 32 random bytes, base64. Encrypts members' health notes at field level. `openssl rand -base64 32`
DATA_ENCRYPTION_KEY=
# Where the web app runs (used for CORS and links in messages)
WEB_ORIGIN=http://localhost:3000
PORT=4000
NODE_ENV=development
# Run the background checks (expiry, unmatched, 72h log timeout, deletion) inside the API process
RUN_SCHEDULER=true
# Shared secret for POST /api/jobs/run when an external cron (e.g. GitHub Actions) triggers jobs
JOBS_SECRET=
# Notifications. Every notification and alert is also emailed to everyone it concerns.
#   NOTIFY_EMAIL_DRIVER: "resend" sends through Resend (set RESEND_API_KEY + EMAIL_FROM),
#   "smtp" sends through any SMTP server (set the SMTP_* values below), "webhook" POSTs to
#   NOTIFY_WEBHOOK_URL (e.g. a Power Automate / Zapier flow), "console" only logs, "none" switches off.
NOTIFY_EMAIL_DRIVER=console
# Resend: an API key with sending access (https://resend.com/api-keys). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
NOTIFY_SMS_DRIVER=console
NOTIFY_WEBHOOK_URL=
# SMTP (Microsoft 365: smtp.office365.com:587, Google Workspace: smtp.gmail.com:587, or your provider).
# Use SMTP_SECURE=true for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PSEBC Lifts <lifts@your-church.org>
EMAIL_REPLY_TO=
# Phone alerts (Web Push). Optional: leave blank to switch off. Generate once with
#   npx web-push generate-vapid-keys
# and keep the private key secret. Changing the keys means everyone turns alerts on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:office@example.org
# Report setting from PRD 7.1 — leave false until per-member figures are added to the DPIA (task 8.12)
REPORTS_SHOW_MEMBER_NAMES=false

# Which PRD epics are switched on: "all", or e.g. "1-3" for the Epics 1–3 demo (onboarding, booking, matching).
ENABLED_EPICS=all
