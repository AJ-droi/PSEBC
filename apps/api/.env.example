# Neon connection string (use the *pooled* URL for the API). Must include sslmode=require on Neon.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-west-2.aws.neon.tech/psebc?sslmode=require
# Long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string
# 32 random bytes, base64. Encrypts members' health notes at field level. `openssl rand -base64 32`
DATA_ENCRYPTION_KEY=
# Where the web app runs (used for CORS and links in messages)
WEB_ORIGIN=http://localhost:3000
PORT=4000
NODE_ENV=development
# Run the background checks (expiry, unmatched, 72h log timeout, deletion) inside the API process
RUN_SCHEDULER=true
# Shared secret for POST /api/jobs/run when an external cron (e.g. GitHub Actions) triggers jobs
JOBS_SECRET=
# Notifications: "console" logs messages. Set to "webhook" to POST them to NOTIFY_WEBHOOK_URL
# (e.g. a Power Automate / Zapier flow that sends the email or SMS).
NOTIFY_EMAIL_DRIVER=console
NOTIFY_SMS_DRIVER=console
NOTIFY_WEBHOOK_URL=
# Report setting from PRD 7.1 — leave false until per-member figures are added to the DPIA (task 8.12)
REPORTS_SHOW_MEMBER_NAMES=false
